# ---------- Ambiente ----------
APP_ENV=development                 # development | staging | production
# Chave para HMAC de códigos e criptografia AES-GCM de segredos. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# ---------- Banco (Supabase) ----------
# Use o "Session pooler" (IPv4) do Supabase: Project Settings > Database > Connection string > Session pooler
# DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/locaplay

# ---------- URLs e cookies ----------
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000          # URL pública da API (webhooks do Mercado Pago)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                           # true em produção (HTTPS)
# COOKIE_DOMAIN=.seudominio.com.br
SESSION_DAYS=14
REQUIRE_ADMIN_MFA=true

# ---------- E-mail ----------
EMAIL_PROVIDER=dev                            # dev (grava em dev_mailbox) | smtp | resend
EMAIL_FROM=LocaPlay <nao-responda@seudominio.com.br>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---------- Pagamentos ----------
PAYMENT_PROVIDER=simulated                    # simulated (só desenvolvimento) | mercadopago
MP_ACCESS_TOKEN=                              # TEST-... para sandbox
MP_WEBHOOK_SECRET=                            # "Assinatura secreta" das notificações (Webhooks) do Mercado Pago
ALLOW_DEMO_SALES=true                         # false em produção: só vende jogos com licença comercial autorizada

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirecionamento autorizada no Google Cloud: {FRONTEND_URL}/api/auth/google/callback

# ---------- Worker ----------
RUN_WORKER=true                               # avisos, expiração de holds/sessões, heartbeats, e-mails
WORKER_INTERVAL_SECONDS=15

# ---------- Seed do superadministrador ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin_locaplay
